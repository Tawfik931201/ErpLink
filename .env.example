# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://b2bf-156-205-205-167.ngrok-free.app
NEXT_PUBLIC_APP_NAME=ZidLink

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# Local PostgreSQL:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zidlink?schema=public"
#
# Supabase pooler runtime URL. Copy it from Supabase:
# Project Settings -> Database -> Connection string -> Pooler.
# Keep sslmode=require, and make sure PROJECT_REF and REGION match your project.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=1&sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://b2bf-156-205-205-167.ngrok-free.app
NEXTAUTH_SECRET=generate_with__openssl_rand_base64_32

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Zid API ─────────────────────────────────────────────────────────────────
# App credentials — from Zid Partner Dashboard. Never expose these to the client.
ZID_CLIENT_ID=your_client_id
ZID_CLIENT_SECRET=your_client_secret

# Must match EXACTLY the Redirection URL registered in Zid app settings.
ZID_REDIRECT_URI=https://b2bf-156-205-205-167.ngrok-free.app/api/zid/callback

# Official Zid OAuth/API endpoints.
ZID_AUTH_URL=https://oauth.zid.sa/oauth/authorize
ZID_TOKEN_URL=https://oauth.zid.sa/oauth/token
ZID_API_URL=https://api.zid.sa/v1

# Optional for local testing without a configured database.
# Leave unset in production to store tokens through Prisma.
ZID_TOKEN_STORAGE=

# Local debugging only. Set to "json" to show callback token data in the browser.
ZID_CALLBACK_RESPONSE=
ZID_DEBUG_STORE_ID=

# Webhook secret — set after registering webhook in Zid Partner Dashboard
ZID_WEBHOOK_SECRET=your_webhook_secret_here
ZID_WEBHOOK_URL=https://b2bf-156-205-205-167.ngrok-free.app/api/webhooks/zid

# ─── Salla API ───────────────────────────────────────────────────────────────
SALLA_APP_ID=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://b2bf-156-205-205-167.ngrok-free.app/api/salla/callback
SALLA_WEBHOOK_SECRET=

# ─── Odoo ────────────────────────────────────────────────────────────────────
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=admin
ODOO_API_KEY=your_odoo_api_key_here

# ─── Redis (for BullMQ queues & caching) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Stripe (subscriptions / billing) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
EMAIL_FROM=noreply@zidlink.app

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Telegram Bot Notifications ───────────────────────────────────────────────
# Each user binds their own Telegram bot (created via @BotFather).
# No central bot token is used — the user's token is encrypted and stored in
# the `telegram_links` table on a per-user basis via the user settings UI.
# The Bot HTTP API is called directly using the user's stored token.
#
# Optional: a rate-limit shared secret for Telegram webhook verification.
# Not required because we use long-polling (getUpdates), not webhooks.
TELEGRAM_POLLER_ENABLED=true


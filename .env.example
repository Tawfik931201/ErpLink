# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://b2bf-156-205-205-167.ngrok-free.app
NEXT_PUBLIC_APP_NAME=ErpLink

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# Local PostgreSQL:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/erplink?schema=public"
#
# Supabase pooler runtime URL. Copy it from Supabase:
# Project Settings -> Database -> Connection string -> Pooler.
# Keep sslmode=require, and make sure PROJECT_REF and REGION match your project.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=1&sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://b2bf-156-205-205-167.ngrok-free.app
NEXTAUTH_SECRET=generate_with__openssl_rand_base64_32

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Zid API ─────────────────────────────────────────────────────────────────
# App credentials — from Zid Partner Dashboard. Never expose these to the client.
ZID_CLIENT_ID=your_client_id
ZID_CLIENT_SECRET=your_client_secret

# Must match EXACTLY the Redirection URL registered in Zid app settings.
ZID_REDIRECT_URI=https://b2bf-156-205-205-167.ngrok-free.app/api/zid/callback

# Official Zid OAuth/API endpoints.
ZID_AUTH_URL=https://oauth.zid.sa/oauth/authorize
ZID_TOKEN_URL=https://oauth.zid.sa/oauth/token
ZID_API_URL=https://api.zid.sa/v1

# Optional for local testing without a configured database.
# Leave unset in production to store tokens through Prisma.
ZID_TOKEN_STORAGE=

# Local debugging only. Set to "json" to show callback token data in the browser.
ZID_CALLBACK_RESPONSE=
ZID_DEBUG_STORE_ID=

# Webhook secret — set after registering webhook in Zid Partner Dashboard
ZID_WEBHOOK_SECRET=your_webhook_secret_here
ZID_WEBHOOK_URL=https://b2bf-156-205-205-167.ngrok-free.app/api/webhooks/zid

# Clerk webhook signing secret — set after adding a webhook endpoint
# at https://dashboard.clerk.com/~/webhooks pointing to /api/webhooks/clerk
# (subscribe to `user.created` to sync new users into the local users table).
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Salla API ───────────────────────────────────────────────────────────────
SALLA_APP_ID=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://b2bf-156-205-205-167.ngrok-free.app/api/salla/callback
SALLA_WEBHOOK_SECRET=

# ─── Shopify API ─────────────────────────────────────────────────────────────
# From the Shopify Partner Dashboard (your custom app credentials).
# SINGLE SOURCE for the public URL: NEXT_PUBLIC_APP_URL (top of this file).
# shopify.app.toml uses ${NEXT_PUBLIC_APP_URL} for application_url + webhook
# URIs + redirect_urls — keep all three in sync. Replace the value of
# NEXT_PUBLIC_APP_URL only; do not hardcode domains per-key.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=${NEXT_PUBLIC_APP_URL}/api/shopify/callback
# Verifies incoming webhooks (X-Shopify-Hmac-Sha256). Required in production.
SHOPIFY_WEBHOOK_SECRET=
# API version used by src/lib/shopify-client.ts (keep in sync with shopify.app.toml
# [webhooks].api_version and SHOPIFY_TOPIC_CATALOG in src/lib/shopify-topics.ts)
SHOPIFY_API_VERSION=2025-07

# ─── Odoo ────────────────────────────────────────────────────────────────────
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=admin
ODOO_API_KEY=your_odoo_api_key_here

# ─── Background sync runner (replaces external cron) ──────────────────────────
# The queue is drained by an in-process runner started at boot from
# src/instrumentation.ts (needs experimental.instrumentationHook: true in
# next.config.js). The current Hostinger host has a `crontab` that installs
# nothing, so there is no working external scheduler — this runner is the
# only drain path and MUST be enabled in production.
SYNC_QUEUE_SELF_RUNNER=true
# Drain period in ms (min 5000, default 30000).
SYNC_QUEUE_POLL_INTERVAL_MS=30000
# Zid reconciliation period in ms (min 60000, default 600000 = 10 min).
SYNC_RECONCILE_INTERVAL_MS=600000
# Shared secret for the manual/HTTP trigger routes. In production a missing
# value makes them return 500. Send it as `Authorization: Bearer <secret>` —
# the only method accepted by BOTH /api/cron/sync-queue and
# /api/cron/reconcile (`?key=` works on reconcile only, x-cron-secret on
# sync-queue only).
CRON_SECRET=
# Load knobs — tune DOWN on shared hosting.
SYNC_QUEUE_CONCURRENCY=10
SYNC_QUEUE_BATCH_SIZE=50
SYNC_QUEUE_MAX_RETRIES=5

# ─── Redis (LEGACY — unused: sync-queue uses the in-process runner, src/lib/redis.ts never imported) ──
REDIS_URL=redis://localhost:6379

# ─── Stripe (LEGACY — unused: manual bank-transfer flow only, no Stripe in src) ──
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
EMAIL_FROM=noreply@erplink.app

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Telegram Bot Notifications ───────────────────────────────────────────────
# Each user binds their own Telegram bot (created via @BotFather).
# No central bot token is used — the user's token is encrypted and stored in
# the `telegram_links` table on a per-user basis via the user settings UI.
# The Bot HTTP API is called directly using the user's stored token.
#
# Optional: a rate-limit shared secret for Telegram webhook verification.
# Not required because we use long-polling (getUpdates), not webhooks.
TELEGRAM_POLLER_ENABLED=true


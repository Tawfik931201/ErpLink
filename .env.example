# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Legacy fallback for APP_URL, still read by src/app/api/zid/callback/route.ts.
# NEXT_PUBLIC_APP_URL wins when both are set.
NEXTAUTH_URL=https://your-domain.com

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
# Required by ClerkProvider (src/app/layout.tsx) and clerkMiddleware
# (src/middleware.ts). Without them the app will not boot.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Only needed if you expose the Clerk sign-in in a custom host.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Signing secret for /api/webhooks/clerk (subscribe to `user.created` to sync
# new signups into the `users` table).
CLERK_WEBHOOK_SECRET=whsec_...

# Comma-separated Clerk user IDs that get admin access. Checked by isAdmin()
# in src/lib/auth.ts; every admin action is guarded by requireAdmin().
ADMIN_USER_IDS=user_2abc...,user_2def...

# ─── Database (Supabase REST) ────────────────────────────────────────────────
# There is no Prisma/Postgres connection string at runtime — SQL is the source
# of truth and every read/write goes through the Supabase REST client with the
# service role key.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# REQUIRED in production. src/lib/supabase.ts throws on boot when it is
# missing, and the sync engines write with it (RLS is bypassed on purpose).
# Never fall back to the anon key: every write would fail silently.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 32-byte base64 key used to encrypt Zid/Salla/Shopify tokens and Telegram bot
# tokens at rest. Generate with: openssl rand -base64 32
# src/lib/crypto.ts refuses to start in production when it is missing.
# Changing it makes every stored token undecryptable — users must re-link.
ENCRYPTION_KEY=

# Comma-separated list of RETIRED keys, accepted for DECRYPTION ONLY.
# Empty (the default) is correct and should stay that way. Only set it when
# stored credentials fail to decrypt: put the old key here, re-save those
# credentials so they are re-encrypted with ENCRYPTION_KEY, then clear it.
ENCRYPTION_LEGACY_KEYS=

# ─── Zid API ─────────────────────────────────────────────────────────────────
# App credentials from the Zid Partner Dashboard. Read via getZidConfig() in
# src/lib/zid/config.ts, which throws if any of the six is missing.
ZID_CLIENT_ID=your_client_id
ZID_CLIENT_SECRET=your_client_secret
# Must match EXACTLY the Redirection URL registered in Zid app settings.
ZID_REDIRECT_URI=https://your-domain.com/api/zid/callback
ZID_AUTH_URL=https://oauth.zid.sa/oauth/authorize
ZID_TOKEN_URL=https://oauth.zid.sa/oauth/token
ZID_API_URL=https://api.zid.sa/v1
# Optional. Overrides the default scope list in src/lib/zid/auth.ts.
ZID_OAUTH_SCOPE=

# Zid does not sign webhooks, so there is no webhook secret to set: the Basic
# credential the ingress route verifies is derived from ENCRYPTION_KEY in
# src/lib/zid/webhook-auth.ts. See AGENTS.md → "Ingress auth".
ZID_WEBHOOK_URL=https://your-domain.com/api/webhooks/zid

# Local debugging only.
# "json" makes the callback return token data in the browser response.
ZID_CALLBACK_RESPONSE=
ZID_DEBUG_STORE_ID=

# ─── Salla API ───────────────────────────────────────────────────────────────
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://your-domain.com/api/salla/callback

# OPTIONAL. Salla's native webhook signing secret, from the Partners Portal
# (64-char SHA256). Leave it EMPTY and ingress still works: the route then trusts
# the credential derived from ENCRYPTION_KEY, which registration attaches per
# subscription as `x-erplink-webhook-secret` (src/lib/salla/webhook-auth.ts).
#
# Set it to enable Salla's native `signature` verification (HMAC-SHA256 of the raw
# body, header `X-Salla-Signature`) or, if you switch the Portal app to the
# `token` strategy, a static token compared against the `Authorization` header.
# Leaving it blank is the supported configuration — an unset value used to make
# the route 500 on every delivery.
#
# Rotating ENCRYPTION_KEY invalidates the derived credential: re-register every
# store with POST /api/admin/salla-webhooks/refresh.
# SALLA_WEBHOOK_SECRET=

# ─── Shopify API ─────────────────────────────────────────────────────────────
# From the Shopify Partner Dashboard (your custom app credentials).
# SINGLE SOURCE for the public URL: NEXT_PUBLIC_APP_URL (top of this file).
# shopify.app.toml uses ${NEXT_PUBLIC_APP_URL} for application_url, webhook
# URIs and redirect_urls — keep all three in sync by changing only
# NEXT_PUBLIC_APP_URL, never hardcode a domain per key.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=${NEXT_PUBLIC_APP_URL}/api/shopify/callback
# Verifies incoming webhooks (X-Shopify-Hmac-Sha256). Shopify signs with the app client secret;\n# leave empty to fall back to SHOPIFY_CLIENT_SECRET, or set the same secret explicitly.\nSHOPIFY_WEBHOOK_SECRET=
# Keep in sync with shopify.app.toml [webhooks].api_version and
# SHOPIFY_TOPIC_CATALOG in src/lib/shopify-topics.ts.
SHOPIFY_API_VERSION=2026-10

# ─── Odoo / ERPNext ──────────────────────────────────────────────────────────
# The admin password is stored encrypted per workspace, so ODOO_* below is only
# the optional bootstrap connection (auto-bootstrap, transfer tools).
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=admin
# NOTE: the code reads ODOO_PASSWORD, not ODOO_API_KEY (src/lib/odoo.ts).
ODOO_PASSWORD=your_odoo_password
# Set to "true" to log every XML-RPC call (src/lib/odoo-client.ts).
ODOO_DEBUG=
# NOTE: there is no ODOO_WEBHOOK_SECRET any more. The credential the two Odoo
# ingress routes verify is HKDF-derived from ENCRYPTION_KEY, scoped
# stock:<workspace_id> / record:<field_mapping_id> (src/lib/odoo/webhook-secret.ts),
# and travels as ?secret= because Odoo's Automated Action cannot send a header.
# Register or re-register actions with POST /api/admin/odoo-webhooks/refresh.

# ─── Webhook hardening (API security review 2026-10-08) ───────────────────────
# STRICT_WEBHOOK_AUTH=false (default) accepts pre-registration `legacy`
# deliveries while counting them (`Unauthenticated delivery #N` in logs).
# Set to `true` ONLY after re-registering every store (the three
# /api/admin/*-refresh endpoints) and seeing those counters reach zero —
# legacy deliveries are then rejected with 401 instead. Keep `false` while
# testing over temporary (ngrok) URLs.
# STRICT_WEBHOOK_AUTH=false

# ─── Background sync runner (replaces external cron) ──────────────────────────
# The queue is drained by an in-process runner started at boot from
# src/instrumentation.ts (stable since Next 15 — no experimental flag needed).
# The current Hostinger host has a `crontab` that installs
# nothing, so there is no working external scheduler — this runner is the
# only drain path and MUST be enabled in production.
SYNC_QUEUE_SELF_RUNNER=true
# Drain period in ms (min 5000, default 30000).
SYNC_QUEUE_POLL_INTERVAL_MS=30000
# Zid reconciliation period in ms (min 60000, default 600000 = 10 min).
SYNC_RECONCILE_INTERVAL_MS=600000
# Shared secret for the manual/HTTP trigger routes. In production a missing
# value makes them return 500. Send it as `Authorization: Bearer <secret>` —
# the only method accepted by BOTH /api/cron/sync-queue and
# /api/cron/reconcile (`?key=` works on reconcile only, x-cron-secret on
# sync-queue only).
CRON_SECRET=
# Load knobs — tune DOWN on shared hosting.
SYNC_QUEUE_CONCURRENCY=10
SYNC_QUEUE_BATCH_SIZE=50
# Per-workspace in-flight cap, so one busy tenant cannot starve the others.
SYNC_QUEUE_MAX_PER_WORKSPACE=3
# NOTE: SYNC_QUEUE_MAX_RETRIES is hardcoded to 5 in src/lib/sync-queue.ts —
# changing it here has no effect. WEBHOOK_INBOX_DRAIN_BATCH is likewise a
# constant (100) in sync-queue-runner.ts.
# SYNC_QUEUE_MAX_RETRIES=5
# ─── Per-item timeout (2026-10-22) ───────────────────────────────────────────
# A single event is wrapped in a timeout so a pathological mapping cannot
# hold a worker slot forever. 120s covers the worst healthy case (~15
# serial XML-RPC calls × 10s each).
# SYNC_QUEUE_ITEM_TIMEOUT_MS=120000
# ─── Coalescing window (2026-10-22) ─────────────────────────────────────────
# How long a freshly-enqueued row waits before it becomes eligible for
# processing. Inside that window, repeated updates to the SAME entity merge
# into one row ⇒ one Odoo write instead of N. 0 = no delay.
# Defaults to 45s while SYNC_SEASON_MODE=true, 0 otherwise.
# SYNC_COALESCE_WINDOW_MS=45000
# ─── Season mode (P3-1: shorter retries inside a ~30min window) ─────────────
# Off by default. Turn ON for peak season only: first retry after 1min
# (not 5), sequence 1/2/4/8/15 capped at 15min — five fair chances inside
# ~30 minutes. Turn back OFF after the season (normal 5/10/20/…/360).
# Also enables the 45s coalescing window above.
# SYNC_SEASON_MODE=true
# ─── Per-workspace circuit breaker (P3-1) ───────────────────────────────────
# After N consecutive failures from one workspace, its due rows are parked
# past the cooldown instead of burning shared worker slots. Success resets
# the counter immediately. Defaults shown — uncomment to tune.
# SYNC_CB_THRESHOLD=10
# SYNC_CB_COOLDOWN_MIN=15
# ─── Ingress admission (2026-10-22) ─────────────────────────────────────────
# Certified deliveries are NEVER rejected: the limit below only decides who
# gets the "fast lane" (and therefore who waits a little longer). The
# anonymous-IP limit (120/min) still applies to requests with no credential
# at all — that is the DoS guard.
# Base ceiling per workspace while the queue is empty (requests/min).
INGRESS_BASE_CEILING=120
# Ceiling per workspace when the queue is full (requests/min).
INGRESS_MAX_CEILING=2000
# Pending depth at which the system counts as "loaded" and the ceiling falls
# back to the base value.
INGRESS_TARGET_PENDING=2000
# Global safety valve for the whole system (requests/min). Exceeding it
# answers 503 (the platform retries) — never 429 (which would lose the event).
INGRESS_GLOBAL_CAP_PER_MIN=20000
# ─── Telegram outbox (2026-10-22) ───────────────────────────────────────────
# Notifications are written to telegram_outbox and sent by a dedicated
# sender. Set to false to stop the sender entirely.
# TELEGRAM_OUTBOX_ENABLED=true
# ─── Admin alerts (2026-10-22) ─────────────────────────────────────────────
# The workspace whose linked Telegram chats receive OPERATIONAL alerts
# (oldest pending > 30min, frozen rows, dead letters, failed receipts,
# a closed global safety valve, unauthenticated rejections).
# Link your own chat to this workspace in /app/settings/notifications.
# Unset => no alerts are sent (the feature is simply off).
# ADMIN_ALERT_WORKSPACE_ID=
# ─── Store pull budget (2026-10-22) ─────────────────────────────────────────
# How long a fetched order detail is reused before it is fetched again.
# ZID_ORDER_CACHE_TTL_MS=180000

# ─── Email ───────────────────────────────────────────────────────────────────
# SendGrid is used when set; otherwise SMTP_* is tried; otherwise emails are
# logged and dropped. Set EMAIL_MOCK_MODE=true to force log-only in dev.
# SENDGRID_API_KEY=SG...
EMAIL_FROM=noreply@your-domain.com
EMAIL_MOCK_MODE=
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Where the public contact form sends its notification (comma-separated, up to
# 5 addresses). The customer's address is set as Reply-To, so replying from the
# inbox answers them directly.
#
# OPTIONAL and OFF by default: every submission is saved to the
# `contact_messages` table and shown in /admin/messages (plus an Odoo helpdesk
# ticket), so leaving this empty loses nothing. Today it is intentionally empty
# — the system inbox is the destination, not email. Requires SendGrid or SMTP_*
# to actually deliver.
# CONTACT_INBOX_EMAIL=info@your-domain.com

# ─── Telegram Bot Notifications ───────────────────────────────────────────────
# Each user binds their own Telegram bot (created via @BotFather). No central
# bot token is used — the user's token is encrypted and stored in
# `telegram_links` and the Bot HTTP API is called with that stored token.
# Long-polling (getUpdates) is used, not webhooks.
# Unset = enabled. Set to "false" to disable the poller entirely.
TELEGRAM_POLLER_ENABLED=true

# Central ERP Link Odoo Studio archive - independent of merchant Odoo
# Configure all four secrets in Hostinger server environment; never NEXT_PUBLIC_.
ERPLINK_ARCHIVE_ODOO_URL=
ERPLINK_ARCHIVE_ODOO_DB=
ERPLINK_ARCHIVE_ODOO_USERNAME=
ERPLINK_ARCHIVE_ODOO_API_KEY=
# Historical contacts have been verified in central Odoo. Default: true when archive credentials exist.
# Set false to roll back the admin inbox to Supabase if required.
ERPLINK_ARCHIVE_ODOO_CONTACTS_READ_PRIMARY=true

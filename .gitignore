# ─── Dependencies ────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ────────────────────────────────────────────────
.next/
out/
build/
dist/

# ─── Environment variables ────────────────────────────────────────
# Every .env* variant is ignored EXCEPT .env.example, which is the only one
# meant to be committed. `.env.production` and `.env.staging` are NOT ignored
# by Next's own template, so they have to be listed explicitly or a deploy can
# commit real credentials.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# ─── Build caches ─────────────────────────────────────────────────
.swc/

# ─── Prisma ──────────────────────────────────────────────────────
prisma/migrations/

# ─── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
# The `logs/` pattern above matches ANY directory named logs — including the
# Sync Logs route directory. Without this exception the page is silently
# untracked and can never be committed or deployed (it was "missing in git
# history" for exactly this reason). Negation must stay AFTER `logs/`.
!src/app/(app)/app/logs/

# ─── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
opencode.json

# ─── Testing ─────────────────────────────────────────────────────
coverage/

# ─── Misc ────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

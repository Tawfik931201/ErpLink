/// Platform category → Odoo product.category with accounting + valuation settings
/// Mirrors Odoo's product.category form (Accounting Properties + Inventory Valuation).
model CategoryMapping {
  id                   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String @db.Uuid
  platform             String @default("zid")
  source_category_name String
  odoo_category_id     Int?
  parent_id            Int?

  /// Accounting Properties
  income_account_id  Int?
  expense_account_id Int?

  /// Inventory Valuation
  property_cost_method String?
  property_valuation   String?

  /// Account Stock Properties
  stock_valuation_account_id Int?
  stock_journal_id           Int?
  stock_input_account_id     Int?
  stock_output_account_id    Int?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, platform, source_category_name])
  @@index([workspace_id, platform])
  @@map("category_mappings")
}

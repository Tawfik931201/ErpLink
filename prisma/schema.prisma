// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Core Models (Mapped to Supabase Tables) ───────────────────────────────────

model User {
  id                  String            @id
  email               String            @unique
  name                String?
  active_workspace_id String?           @db.Uuid
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  active_workspace    Workspace?        @relation("ActiveWorkspace", fields: [active_workspace_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owned_workspaces    Workspace[]       @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  clerk_org_id String?  @unique
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user_id      String?

  owner            User?             @relation("WorkspaceOwner", fields: [user_id], references: [id], onDelete: Cascade)
  active_users     User[]            @relation("ActiveWorkspace")
  members          WorkspaceMember[]
  merchant_tokens  MerchantToken[]
  odoo_connections OdooConnection[]
  field_mappings   FieldMapping[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspace_id String   @db.Uuid
  user_id      String
  role         String?  @default("member")
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, user_id])
  @@map("workspace_members")
}

model MerchantToken {
  merchant_id         String   @id
  access_token        String
  token_type          String
  expires_in          BigInt?
  authorization_token String
  refresh_token       String
  updated_at          DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  old_id              BigInt?
  uuid                String?
  name                String?
  username            String?
  email               String?
  store_id            String?
  workspace_id        String?  @db.Uuid
  sync_settings       Json?    @default("{}")

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  field_mappings FieldMapping[]

  @@map("merchant_tokens")
}

model OdooConnection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String?  @db.Uuid
  erp_type        String   @default("odoo")
  connection_name String
  url             String
  db_name         String?
  username        String
  password        String
  status          String?  @default("connected")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace      Workspace?     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  field_mappings FieldMapping[]

  @@map("odoo_connections")
}

model FieldMapping {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  workspace_id       String?  @db.Uuid
  odoo_connection_id String?  @db.Uuid
  merchant_id        String
  store_id           String?
  action             String
  odoo_model         String?  @default("")
  odoo_operation     String   @default("create")
  odoo_match_field   String?
  zid_match_field    String?
  mappings           Json?    @default("[]")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace       Workspace?      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  odoo_connection OdooConnection? @relation(fields: [odoo_connection_id], references: [id], onDelete: Cascade)
  merchant_token  MerchantToken   @relation(fields: [merchant_id], references: [merchant_id], onDelete: Cascade)

  @@map("field_mappings")
}
